{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-symphony.dev/schemas/run_event.schema.json",
  "title": "RunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "id",
    "project_id",
    "event_type",
    "actor_type",
    "data",
    "redacted",
    "created_at"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "project_id": {
      "type": "string"
    },
    "issue_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "enum": [
        "system",
        "operator",
        "agent",
        "codex",
        "hook"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "redacted": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
