{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-symphony.dev/schemas/review_packet.schema.json",
  "title": "Review Packet File",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "packet_no",
    "status",
    "issue",
    "run",
    "git",
    "files",
    "handoff",
    "changed_files",
    "untracked_files",
    "approvals",
    "tool_calls",
    "prompt_snapshot",
    "failure_code",
    "failure_message",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rp_"
    },
    "packet_no": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "generated",
        "partial",
        "failed"
      ]
    },
    "issue": {
      "type": "object",
      "required": [
        "id",
        "identifier",
        "title"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^iss_"
        },
        "identifier": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "status",
        "source_issue_state"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^run_"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "completed_without_handoff"
          ]
        },
        "source_issue_state": {
          "enum": [
            "Ready",
            "Rework"
          ]
        }
      }
    },
    "git": {
      "type": "object",
      "required": [
        "branch_name",
        "base_ref",
        "base_ref_config",
        "base_sha"
      ],
      "additionalProperties": true,
      "properties": {
        "branch_name": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "base_ref_config": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_md_path": {
          "type": "string"
        },
        "review_json_path": {
          "type": "string"
        },
        "patch_path": {
          "type": "string"
        },
        "changed_files_path": {
          "type": "string"
        },
        "untracked_files_path": {
          "type": "string"
        },
        "diffstat_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "summary",
        "tests",
        "risks",
        "verification",
        "followups",
        "target_state"
      ],
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "string"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "followups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_state": {
          "const": "Human Review"
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": true,
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "patch_included": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "untracked_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size_bytes",
          "sha256",
          "patch_included"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string"
          },
          "patch_included": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "patch_included": {
                  "const": false
                }
              },
              "required": [
                "patch_included"
              ]
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "prompt_snapshot": {
      "type": "object",
      "required": [
        "id",
        "rendered_prompt_hash",
        "tool_manifest_path"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ps_"
        },
        "rendered_prompt_hash": {
          "type": "string"
        },
        "tool_manifest_path": {
          "type": "string"
        }
      }
    },
    "failure_code": {
      "enum": [
        "workflow_invalid",
        "workflow_validation_failed",
        "prompt_render_failed",
        "workspace_prepare_failed",
        "workspace_conflict",
        "after_create_failed",
        "before_run_failed",
        "codex_startup_failed",
        "unsupported_codex_version",
        "codex_protocol_error",
        "turn_timeout",
        "stall_timeout",
        "approval_timeout",
        "command_denied",
        "network_denied",
        "protected_path_denied",
        "tool_gateway_failed",
        "missing_handoff",
        "review_packet_failed",
        "operator_cancelled",
        "agent_blocked",
        "issue_state_changed",
        "canceled_by_reconciliation",
        "daemon_restarted_run_interrupted",
        null
      ]
    },
    "failure_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "generated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "files"
        ],
        "properties": {
          "files": {
            "required": [
              "review_md_path",
              "review_json_path",
              "patch_path",
              "changed_files_path",
              "untracked_files_path"
            ]
          }
        }
      }
    }
  ]
}
