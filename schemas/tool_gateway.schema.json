{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-symphony.dev/schemas/tool_gateway.schema.json",
  "title": "Tool Gateway Call",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "toolName": {
      "enum": [
        "issue.get",
        "issue.comment",
        "issue.block",
        "artifact.attach",
        "followup.create",
        "handoff.submit"
      ]
    },
    "issueGetInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "issueCommentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "issueBlockInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "details": { "type": "string" }
      }
    },
    "artifactAttachInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(^/)|(^[A-Za-z]:)|(^|/)\\.\\.(/|$)" }
        },
        "kind": {
          "enum": ["test_output", "patch", "changed_files", "untracked_files", "diffstat", "prompt_snapshot", "codex_log", "review_packet", "agent_file", "diagnostic", "other"]
        },
        "description": { "type": "string" }
      }
    },
    "followupCreateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "default": [] },
        "labels": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 }
      }
    },
    "handoffSubmitInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "changed_files", "tests", "risks", "verification"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "changed_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tests": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "items": { "type": "string" } },
        "followups": { "type": "array", "items": { "type": "string" }, "default": [] },
        "target_state": { "const": "Human Review" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "input"],
      "properties": {
        "tool": { "$ref": "#/$defs/toolName" },
        "input": { "type": "object" },
        "client": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        { "if": { "properties": { "tool": { "const": "issue.get" } }, "required": ["tool"] }, "then": { "properties": { "input": { "$ref": "#/$defs/issueGetInput" } } } },
        { "if": { "properties": { "tool": { "const": "issue.comment" } }, "required": ["tool"] }, "then": { "properties": { "input": { "$ref": "#/$defs/issueCommentInput" } } } },
        { "if": { "properties": { "tool": { "const": "issue.block" } }, "required": ["tool"] }, "then": { "properties": { "input": { "$ref": "#/$defs/issueBlockInput" } } } },
        { "if": { "properties": { "tool": { "const": "artifact.attach" } }, "required": ["tool"] }, "then": { "properties": { "input": { "$ref": "#/$defs/artifactAttachInput" } } } },
        { "if": { "properties": { "tool": { "const": "followup.create" } }, "required": ["tool"] }, "then": { "properties": { "input": { "$ref": "#/$defs/followupCreateInput" } } } },
        { "if": { "properties": { "tool": { "const": "handoff.submit" } }, "required": ["tool"] }, "then": { "properties": { "input": { "$ref": "#/$defs/handoffSubmitInput" } } } }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "type": "object", "additionalProperties": true }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "details": { "type": "object", "additionalProperties": true }
          }
        }
      }
    }
  }
}
