{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-symphony.dev/schemas/tool_gateway.schema.json",
  "title": "Tool Gateway Call",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "toolName": {
      "enum": [
        "issue.get",
        "issue.comment",
        "issue.block",
        "artifact.attach",
        "followup.create",
        "handoff.submit"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "input"
      ],
      "properties": {
        "tool": {
          "$ref": "#/$defs/toolName"
        },
        "input": {
          "type": "object",
          "additionalProperties": true
        },
        "client": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
